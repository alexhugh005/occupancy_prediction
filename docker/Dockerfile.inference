# Inference / model serving container
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
# Model artifacts are expected to be mounted or copied at build/runtime
# For production, prefer mounting a volume or using a model registry pull
COPY models/ ./models/

ENV PYTHONPATH=/app/src
ENV MODEL_DIR=/app/models

EXPOSE 8000

CMD ["uvicorn", "inference:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "src"]
